From 23e3e81ad1d2e016da9d75b3e886c8787f4337b3 Mon Sep 17 00:00:00 2001
From: Romeu Melur <romeumello@icloud.com>
Date: Tue, 3 Nov 2026 14:53:42 -0300
Subject: [PATCH 1/2] utils/macos/epoll: delete each kqueue filter in its own
 call

Removing an fd deletes both its EVFILT_READ and EVFILT_WRITE filters in
one kevent() call with no event list. When the READ filter was not
registered that call failed and the WRITE filter stayed in place, so the
fd kept being reported as writable after its removal.

No caller polled a connected socket for output until now, so this did
not show. Apply each deletion on its own and ignore the ones for filters
that were not registered.

Assisted-by: Claude Code: claude-opus-5.5
Signed-off-by: Romeu Melur <romeumello@icloud.com>
---
 src/utils/src/macos/epoll.rs | 25 +++++++++++++++----------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/src/utils/src/macos/epoll.rs b/src/utils/src/macos/epoll.rs
index cae27154..f1791768 100644
--- a/src/utils/src/macos/epoll.rs
+++ b/src/utils/src/macos/epoll.rs
@@ -261,16 +261,21 @@ impl Epoll {
                         ));
                     }
                 }
-                let _ = unsafe {
-                    libc::kevent(
-                        self.queue,
-                        kevs.as_ptr() as *const libc::kevent,
-                        kevs.len() as i32,
-                        ptr::null_mut(),
-                        0,
-                        ptr::null(),
-                    )
-                };
+                // One call per filter: kevent() stops at the first change that fails,
+                // so deleting a READ filter that isn't registered would leave the
+                // WRITE filter in place, firing forever.
+                for kev in &kevs {
+                    let _ = unsafe {
+                        libc::kevent(
+                            self.queue,
+                            kev as *const Kevent as *const libc::kevent,
+                            1,
+                            ptr::null_mut(),
+                            0,
+                            ptr::null(),
+                        )
+                    };
+                }
             }
         }
         Ok(())
