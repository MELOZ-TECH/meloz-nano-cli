diff --git a/tests/test_cases/src/test_virtiofs_host_changes.rs b/tests/test_cases/src/test_virtiofs_host_changes.rs
new file mode 100644
index 00000000..5cba5b91
--- /dev/null
+++ b/tests/test_cases/src/test_virtiofs_host_changes.rs
@@ -0,0 +1,197 @@
+#![cfg(any(feature = "host", target_os = "linux"))]
+
+//! A virtiofs share with `set_cache_timeouts(0, 0)` must show changes made on
+//! the host right away: a file that grew is read with its new size, a new file
+//! appears and a file replaced by rename (as editors save) shows the new
+//! contents. With the default 5 s timeouts the guest read the old size and got
+//! truncated contents.
+
+use macros::{guest, host};
+
+pub struct TestVirtiofsHostChanges;
+
+/// The guest connects out on this port to synchronize with the host.
+const CONTROL_PORT: u32 = 1234;
+const TAG: &str = "shared";
+
+const OLD: &str = "abc";
+const NEW: &str = "abcdefghijklmnop: grown on the host";
+const CREATED: &str = "created on the host";
+const REPLACED: &str = "replaced by rename on the host";
+
+#[host]
+mod host {
+    use super::*;
+    #[cfg(feature = "dynamic-linking")]
+    use krun::DeviceManager;
+
+    use std::fs;
+    use std::io::{Read, Write};
+    use std::os::unix::net::UnixListener;
+    use std::path::Path;
+    use std::thread;
+
+    use crate::common::{build_init_config, init_krun, setup_standard_devices};
+    use crate::{ShouldRun, Test, TestSetup};
+
+    #[cfg(feature = "dynamic-linking")]
+    fn require_symbols() -> Result<(), libloading::Error> {
+        crate::common::require_vm_symbols()?;
+        krun::require(
+            None,
+            &[
+                krun::Symbol::KrunFsDeviceNew,
+                krun::Symbol::KrunFsDeviceSetCacheTimeouts,
+                krun::Symbol::KrunVsockDeviceNew,
+                krun::Symbol::KrunVsockDeviceDestroy,
+                krun::Symbol::KrunVsockDeviceAddUnixPort,
+            ],
+        )
+    }
+
+    fn change_files(dir: &Path) {
+        fs::write(dir.join("grow.txt"), NEW).unwrap();
+        fs::write(dir.join("new.txt"), CREATED).unwrap();
+        fs::write(dir.join("replace.tmp"), REPLACED).unwrap();
+        fs::rename(dir.join("replace.tmp"), dir.join("replace.txt")).unwrap();
+    }
+
+    fn run(listener: UnixListener, dir: &Path) {
+        let (mut control, _) = listener.accept().unwrap();
+        // The guest has read the original files.
+        control.read_exact(&mut [0]).unwrap();
+        change_files(dir);
+        control.write_all(&[1]).unwrap();
+        // Keep the connection open until the guest is done.
+        let _ = control.read(&mut [0]);
+    }
+
+    impl Test for TestVirtiofsHostChanges {
+        fn should_run(&self) -> ShouldRun {
+            #[cfg(feature = "dynamic-linking")]
+            if require_symbols().is_err() {
+                return ShouldRun::No("feature not enabled in this libkrun build");
+            }
+            ShouldRun::Yes
+        }
+
+        fn timeout_secs(&self) -> u64 {
+            30
+        }
+
+        fn start_vm(self: Box<Self>, test_setup: TestSetup) -> anyhow::Result<()> {
+            init_krun()?;
+            #[cfg(feature = "dynamic-linking")]
+            require_symbols().unwrap();
+
+            let shared = test_setup.tmp_dir.join("shared");
+            fs::create_dir(&shared)?;
+            fs::write(shared.join("grow.txt"), OLD)?;
+            fs::write(shared.join("replace.txt"), OLD)?;
+
+            let control_sock = test_setup.tmp_dir.join("control.sock");
+            let listener = UnixListener::bind(&control_sock)?;
+            let shared_clone = shared.clone();
+            thread::spawn(move || run(listener, &shared_clone));
+
+            let init_config = build_init_config(&test_setup.test_case, &[]);
+            let stdin = std::io::stdin();
+            let stdout = std::io::stdout();
+            let stderr = std::io::stderr();
+            let (mut devices, payload) =
+                setup_standard_devices(&test_setup, &init_config, &stdin, &stdout, &stderr)?;
+
+            let mut fs_dev = krun::FsDevice::new(TAG, shared.to_str().unwrap())
+                .map_err(|e| anyhow::anyhow!("FsDevice::new: {e:?}"))?;
+            fs_dev
+                .set_cache_timeouts(0, 0)
+                .map_err(|e| anyhow::anyhow!("set_cache_timeouts: {e:?}"))?;
+            devices.add(fs_dev);
+
+            let mut vsock = krun::VsockDevice::new(3, krun::TsiFlags::empty())
+                .map_err(|e| anyhow::anyhow!("VsockDevice: {e:?}"))?;
+            vsock.add_unix_port(CONTROL_PORT, control_sock.to_str().unwrap(), false);
+            devices.add(vsock);
+
+            let vmm = krun::VmmBuilder::new()
+                .vcpus(1)
+                .map_err(|e| anyhow::anyhow!("vcpus: {e:?}"))?
+                .ram_mib(512)
+                .map_err(|e| anyhow::anyhow!("ram_mib: {e:?}"))?
+                .payload(payload)
+                .devices(devices)
+                .build()
+                .map_err(|e| anyhow::anyhow!("build: {e:?}"))?;
+
+            vmm.run();
+            unreachable!()
+        }
+    }
+}
+
+#[guest]
+mod guest {
+    use super::*;
+    use crate::Test;
+    use nix::libc::{self, VMADDR_CID_HOST};
+    use nix::sys::socket::{AddressFamily, SockFlag, SockType, VsockAddr, connect, socket};
+    use std::ffi::CString;
+    use std::fs;
+    use std::io::{Read, Write};
+    use std::os::fd::AsRawFd;
+    use std::os::unix::net::UnixStream;
+
+    fn mount_share() {
+        fs::create_dir_all("/mnt/shared").unwrap();
+        let source = CString::new(TAG).unwrap();
+        let target = CString::new("/mnt/shared").unwrap();
+        let fstype = CString::new("virtiofs").unwrap();
+        let ret = unsafe {
+            libc::mount(
+                source.as_ptr(),
+                target.as_ptr(),
+                fstype.as_ptr(),
+                0,
+                std::ptr::null(),
+            )
+        };
+        assert_eq!(ret, 0, "mount: {}", std::io::Error::last_os_error());
+    }
+
+    fn read(name: &str) -> String {
+        fs::read_to_string(format!("/mnt/shared/{name}")).unwrap()
+    }
+
+    impl Test for TestVirtiofsHostChanges {
+        fn in_guest(self: Box<Self>) {
+            mount_share();
+
+            // Cache the entries and attributes of the original files.
+            assert_eq!(read("grow.txt"), OLD);
+            assert_eq!(read("replace.txt"), OLD);
+            assert!(fs::metadata("/mnt/shared/new.txt").is_err());
+
+            let sock = socket(
+                AddressFamily::Vsock,
+                SockType::Stream,
+                SockFlag::empty(),
+                None,
+            )
+            .unwrap();
+            connect(
+                sock.as_raw_fd(),
+                &VsockAddr::new(VMADDR_CID_HOST, CONTROL_PORT),
+            )
+            .unwrap();
+            let mut control = UnixStream::from(sock);
+            control.write_all(&[1]).unwrap();
+            control.read_exact(&mut [0]).unwrap();
+
+            assert_eq!(read("grow.txt"), NEW, "grown file read with a stale size");
+            assert_eq!(read("new.txt"), CREATED, "new file not visible");
+            assert_eq!(read("replace.txt"), REPLACED, "replaced file still old");
+            control.write_all(&[1]).unwrap();
+            println!("OK");
+        }
+    }
+}
diff --git a/tests/test_cases/src/test_vsock_unix_half_close.rs b/tests/test_cases/src/test_vsock_unix_half_close.rs
new file mode 100644
index 00000000..d74e2e63
--- /dev/null
+++ b/tests/test_cases/src/test_vsock_unix_half_close.rs
@@ -0,0 +1,252 @@
+#![cfg(any(feature = "host", target_os = "linux"))]
+
+//! The host side of a unix socket proxy sends a request, shuts down its write
+//! side and expects the whole reply followed by EOF, the way the Docker CLI
+//! talks to a daemon. This used to reset the connection as soon as the host's
+//! EOF reached the proxy, so the guest could never answer. Both directions are
+//! covered: the host connecting to a guest listener (`listen=true`) and the
+//! guest connecting out to a host listener (`listen=false`).
+
+use macros::{guest, host};
+use std::time::Duration;
+
+pub struct TestVsockUnixHalfClose;
+
+/// The guest connects out on this port once its listener is bound, and the
+/// host reports the outcome back on the same connection.
+const CONTROL_PORT: u32 = 1234;
+/// Registered with `listen=true`: the host connects, the guest accepts.
+const ACCEPT_PORT: u32 = 1235;
+/// Registered with `listen=false`: the guest connects, the host accepts.
+const CONNECT_PORT: u32 = 1236;
+
+const EXCHANGES: [(usize, usize); 3] = [(17, 17), (256 * 1024, 256 * 1024), (0, 17)];
+const IO_TIMEOUT: Duration = Duration::from_secs(5);
+
+fn payload(seed: u8, len: usize) -> Vec<u8> {
+    (0..len)
+        .map(|index| (index as u8).wrapping_add(seed))
+        .collect()
+}
+
+#[host]
+mod host {
+    use super::*;
+    #[cfg(feature = "dynamic-linking")]
+    use krun::DeviceManager;
+
+    use anyhow::{Context, ensure};
+    use std::io::{Read, Write};
+    use std::net::Shutdown;
+    use std::os::unix::net::{UnixListener, UnixStream};
+    use std::path::Path;
+    use std::thread;
+    use std::time::Instant;
+
+    use crate::common::{build_init_config, init_krun, setup_standard_devices};
+    use crate::{ShouldRun, Test, TestSetup};
+
+    #[cfg(feature = "dynamic-linking")]
+    fn require_symbols() -> Result<(), libloading::Error> {
+        crate::common::require_vm_symbols()?;
+        krun::require(
+            None,
+            &[
+                krun::Symbol::KrunVsockDeviceNew,
+                krun::Symbol::KrunVsockDeviceDestroy,
+                krun::Symbol::KrunVsockDeviceAddUnixPort,
+            ],
+        )
+    }
+
+    /// Send the request, half-close it and read the reply up to EOF.
+    fn exchange(mut stream: UnixStream, index: usize) -> anyhow::Result<()> {
+        let (request_len, response_len) = EXCHANGES[index];
+        stream.set_read_timeout(Some(IO_TIMEOUT))?;
+        stream.set_write_timeout(Some(IO_TIMEOUT))?;
+        stream
+            .write_all(&payload(index as u8, request_len))
+            .context("send request")?;
+        stream
+            .shutdown(Shutdown::Write)
+            .context("half-close request")?;
+
+        let started = Instant::now();
+        let mut response = Vec::new();
+        stream
+            .read_to_end(&mut response)
+            .context("receive reply and EOF")?;
+        ensure!(
+            started.elapsed() < IO_TIMEOUT,
+            "reply and EOF took at least {IO_TIMEOUT:?}"
+        );
+        ensure!(
+            response == payload((index as u8).wrapping_add(128), response_len),
+            "incorrect reply for exchange {index}: {} bytes",
+            response.len()
+        );
+        Ok(())
+    }
+
+    fn run_client(accept_sock: &Path, connect_listener: &UnixListener) -> anyhow::Result<()> {
+        for index in 0..EXCHANGES.len() {
+            let stream = UnixStream::connect(accept_sock).context("connect to guest")?;
+            exchange(stream, index).with_context(|| format!("host-initiated exchange {index}"))?;
+        }
+        for index in 0..EXCHANGES.len() {
+            let (stream, _) = connect_listener.accept().context("accept guest")?;
+            exchange(stream, index).with_context(|| format!("guest-initiated exchange {index}"))?;
+        }
+        Ok(())
+    }
+
+    fn run(control_listener: UnixListener, accept_sock: &Path, connect_listener: UnixListener) {
+        // Returns once the guest has bound its listener.
+        let (mut control, _) = control_listener.accept().unwrap();
+
+        let status = match run_client(accept_sock, &connect_listener) {
+            Ok(()) => 1,
+            Err(error) => {
+                eprintln!("half-close client failed: {error:#}");
+                0
+            }
+        };
+        control.write_all(&[status]).unwrap();
+        // Keep the connection open until the guest has read the status.
+        let _ = control.read(&mut [0]);
+    }
+
+    impl Test for TestVsockUnixHalfClose {
+        fn should_run(&self) -> ShouldRun {
+            #[cfg(feature = "dynamic-linking")]
+            if require_symbols().is_err() {
+                return ShouldRun::No("feature not enabled in this libkrun build");
+            }
+            ShouldRun::Yes
+        }
+
+        fn timeout_secs(&self) -> u64 {
+            30
+        }
+
+        fn start_vm(self: Box<Self>, test_setup: TestSetup) -> anyhow::Result<()> {
+            init_krun()?;
+            #[cfg(feature = "dynamic-linking")]
+            require_symbols().unwrap();
+
+            let control_sock = test_setup.tmp_dir.join("control.sock");
+            let accept_sock = test_setup.tmp_dir.join("accept.sock");
+            let connect_sock = test_setup.tmp_dir.join("connect.sock");
+
+            let control_listener = UnixListener::bind(&control_sock)?;
+            let connect_listener = UnixListener::bind(&connect_sock)?;
+            let accept_sock_clone = accept_sock.clone();
+            thread::spawn(move || run(control_listener, &accept_sock_clone, connect_listener));
+
+            let init_config = build_init_config(&test_setup.test_case, &[]);
+            let stdin = std::io::stdin();
+            let stdout = std::io::stdout();
+            let stderr = std::io::stderr();
+            let (mut devices, payload) =
+                setup_standard_devices(&test_setup, &init_config, &stdin, &stdout, &stderr)?;
+            let mut vsock = krun::VsockDevice::new(3, krun::TsiFlags::empty())
+                .map_err(|e| anyhow::anyhow!("VsockDevice: {e:?}"))?;
+            vsock.add_unix_port(CONTROL_PORT, control_sock.to_str().unwrap(), false);
+            vsock.add_unix_port(ACCEPT_PORT, accept_sock.to_str().unwrap(), true);
+            vsock.add_unix_port(CONNECT_PORT, connect_sock.to_str().unwrap(), false);
+            devices.add(vsock);
+
+            let vmm = krun::VmmBuilder::new()
+                .vcpus(1)
+                .map_err(|e| anyhow::anyhow!("vcpus: {e:?}"))?
+                .ram_mib(512)
+                .map_err(|e| anyhow::anyhow!("ram_mib: {e:?}"))?
+                .payload(payload)
+                .devices(devices)
+                .build()
+                .map_err(|e| anyhow::anyhow!("build: {e:?}"))?;
+
+            vmm.run();
+            unreachable!()
+        }
+    }
+}
+
+#[guest]
+mod guest {
+    use super::*;
+    use crate::Test;
+    use nix::libc::VMADDR_CID_HOST;
+    use nix::sys::socket::{
+        AddressFamily, Backlog, SockFlag, SockType, VsockAddr, accept, bind, connect, listen,
+        socket,
+    };
+    use std::io::{Read, Write};
+    use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+    use std::os::unix::net::UnixStream;
+
+    fn vsock_connect(port: u32) -> UnixStream {
+        let sock = socket(
+            AddressFamily::Vsock,
+            SockType::Stream,
+            SockFlag::empty(),
+            None,
+        )
+        .unwrap();
+        connect(sock.as_raw_fd(), &VsockAddr::new(VMADDR_CID_HOST, port)).unwrap();
+        UnixStream::from(sock)
+    }
+
+    /// Read the request up to the host's EOF, then reply and close.
+    fn serve(mut stream: UnixStream, index: usize) {
+        let (request_len, response_len) = EXCHANGES[index];
+        stream.set_read_timeout(Some(IO_TIMEOUT)).unwrap();
+        stream.set_write_timeout(Some(IO_TIMEOUT)).unwrap();
+        let mut request = Vec::new();
+        stream.read_to_end(&mut request).unwrap();
+        assert_eq!(request, payload(index as u8, request_len));
+        stream
+            .write_all(&payload((index as u8).wrapping_add(128), response_len))
+            .unwrap();
+    }
+
+    impl Test for TestVsockUnixHalfClose {
+        fn in_guest(self: Box<Self>) {
+            let listener = socket(
+                AddressFamily::Vsock,
+                SockType::Stream,
+                SockFlag::empty(),
+                None,
+            )
+            .unwrap();
+            bind(
+                listener.as_raw_fd(),
+                &VsockAddr::new(nix::libc::VMADDR_CID_ANY, ACCEPT_PORT),
+            )
+            .unwrap();
+            listen(&listener, Backlog::new(4).unwrap()).unwrap();
+
+            let mut control = vsock_connect(CONTROL_PORT);
+
+            for index in 0..EXCHANGES.len() {
+                let fd = accept(listener.as_raw_fd()).unwrap();
+                // Safe because we've just obtained the FD from the `accept` call above.
+                let stream = UnixStream::from(unsafe { OwnedFd::from_raw_fd(fd) });
+                serve(stream, index);
+            }
+            for index in 0..EXCHANGES.len() {
+                serve(vsock_connect(CONNECT_PORT), index);
+            }
+
+            let mut status = [0];
+            control.read_exact(&mut status).unwrap();
+            control.write_all(&[1]).unwrap();
+            assert_eq!(
+                status,
+                [1],
+                "host did not receive the complete replies and EOF"
+            );
+            println!("OK");
+        }
+    }
+}
diff --git a/tests/test_cases/src/test_vsock_unix_slow_reader.rs b/tests/test_cases/src/test_vsock_unix_slow_reader.rs
new file mode 100644
index 00000000..1eb46799
--- /dev/null
+++ b/tests/test_cases/src/test_vsock_unix_slow_reader.rs
@@ -0,0 +1,225 @@
+#![cfg(any(feature = "host", target_os = "linux"))]
+
+//! A host peer that stops reading a unix socket proxy must not stall the other
+//! vsock connections. The guest streams `BULK_LEN` bytes on one connection while
+//! the host leaves it unread, and the host expects an answer on a second
+//! connection meanwhile; then it reads the whole stream and checks it.
+//! Writing to the host socket used to block the thread that serves every vsock
+//! connection (and the other devices), so the second connection never got its
+//! answer.
+
+use macros::{guest, host};
+use std::time::Duration;
+
+pub struct TestVsockUnixSlowReader;
+
+/// The guest connects out on this port once its listener is bound, and the
+/// host reports the outcome back on the same connection.
+const CONTROL_PORT: u32 = 1234;
+/// Registered with `listen=true`: the host connects, the guest accepts.
+const ACCEPT_PORT: u32 = 1235;
+
+const BULK_LEN: usize = 16 * 1024 * 1024;
+const IO_TIMEOUT: Duration = Duration::from_secs(5);
+
+fn byte_at(index: usize) -> u8 {
+    (index % 251) as u8
+}
+
+#[host]
+mod host {
+    use super::*;
+    #[cfg(feature = "dynamic-linking")]
+    use krun::DeviceManager;
+
+    use anyhow::{Context, ensure};
+    use std::io::{Read, Write};
+    use std::os::unix::net::{UnixListener, UnixStream};
+    use std::path::Path;
+    use std::thread;
+
+    use crate::common::{build_init_config, init_krun, setup_standard_devices};
+    use crate::{ShouldRun, Test, TestSetup};
+
+    #[cfg(feature = "dynamic-linking")]
+    fn require_symbols() -> Result<(), libloading::Error> {
+        crate::common::require_vm_symbols()?;
+        krun::require(
+            None,
+            &[
+                krun::Symbol::KrunVsockDeviceNew,
+                krun::Symbol::KrunVsockDeviceDestroy,
+                krun::Symbol::KrunVsockDeviceAddUnixPort,
+            ],
+        )
+    }
+
+    fn run_client(accept_sock: &Path) -> anyhow::Result<()> {
+        let mut bulk = UnixStream::connect(accept_sock).context("connect bulk")?;
+        // Leave the bulk stream unread long enough for its socket buffer to fill.
+        thread::sleep(Duration::from_secs(1));
+
+        let mut ping = UnixStream::connect(accept_sock).context("connect ping")?;
+        ping.set_read_timeout(Some(IO_TIMEOUT))?;
+        ping.write_all(b"p").context("send ping")?;
+        let mut pong = [0; 4];
+        ping.read_exact(&mut pong)
+            .context("no answer on a second connection while the first is unread")?;
+        ensure!(&pong == b"pong", "wrong answer: {pong:?}");
+
+        bulk.set_read_timeout(Some(IO_TIMEOUT))?;
+        let mut data = Vec::new();
+        bulk.read_to_end(&mut data).context("read bulk stream")?;
+        ensure!(data.len() == BULK_LEN, "bulk stream has {} bytes", data.len());
+        ensure!(
+            data.iter().enumerate().all(|(i, b)| *b == byte_at(i)),
+            "bulk stream is corrupted"
+        );
+        Ok(())
+    }
+
+    fn run(control_listener: UnixListener, accept_sock: &Path) {
+        // Returns once the guest has bound its listener.
+        let (mut control, _) = control_listener.accept().unwrap();
+
+        let status = match run_client(accept_sock) {
+            Ok(()) => 1,
+            Err(error) => {
+                eprintln!("slow reader client failed: {error:#}");
+                0
+            }
+        };
+        control.write_all(&[status]).unwrap();
+        // Keep the connection open until the guest has read the status.
+        let _ = control.read(&mut [0]);
+    }
+
+    impl Test for TestVsockUnixSlowReader {
+        fn should_run(&self) -> ShouldRun {
+            #[cfg(feature = "dynamic-linking")]
+            if require_symbols().is_err() {
+                return ShouldRun::No("feature not enabled in this libkrun build");
+            }
+            ShouldRun::Yes
+        }
+
+        fn timeout_secs(&self) -> u64 {
+            30
+        }
+
+        fn start_vm(self: Box<Self>, test_setup: TestSetup) -> anyhow::Result<()> {
+            init_krun()?;
+            #[cfg(feature = "dynamic-linking")]
+            require_symbols().unwrap();
+
+            let control_sock = test_setup.tmp_dir.join("control.sock");
+            let accept_sock = test_setup.tmp_dir.join("accept.sock");
+
+            let control_listener = UnixListener::bind(&control_sock)?;
+            let accept_sock_clone = accept_sock.clone();
+            thread::spawn(move || run(control_listener, &accept_sock_clone));
+
+            let init_config = build_init_config(&test_setup.test_case, &[]);
+            let stdin = std::io::stdin();
+            let stdout = std::io::stdout();
+            let stderr = std::io::stderr();
+            let (mut devices, payload) =
+                setup_standard_devices(&test_setup, &init_config, &stdin, &stdout, &stderr)?;
+            let mut vsock = krun::VsockDevice::new(3, krun::TsiFlags::empty())
+                .map_err(|e| anyhow::anyhow!("VsockDevice: {e:?}"))?;
+            vsock.add_unix_port(CONTROL_PORT, control_sock.to_str().unwrap(), false);
+            vsock.add_unix_port(ACCEPT_PORT, accept_sock.to_str().unwrap(), true);
+            devices.add(vsock);
+
+            let vmm = krun::VmmBuilder::new()
+                .vcpus(1)
+                .map_err(|e| anyhow::anyhow!("vcpus: {e:?}"))?
+                .ram_mib(512)
+                .map_err(|e| anyhow::anyhow!("ram_mib: {e:?}"))?
+                .payload(payload)
+                .devices(devices)
+                .build()
+                .map_err(|e| anyhow::anyhow!("build: {e:?}"))?;
+
+            vmm.run();
+            unreachable!()
+        }
+    }
+}
+
+#[guest]
+mod guest {
+    use super::*;
+    use crate::Test;
+    use nix::libc::VMADDR_CID_HOST;
+    use nix::sys::socket::{
+        AddressFamily, Backlog, SockFlag, SockType, VsockAddr, accept, bind, connect, listen,
+        socket,
+    };
+    use std::io::{Read, Write};
+    use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+    use std::os::unix::net::UnixStream;
+    use std::thread;
+
+    fn vsock_connect(port: u32) -> UnixStream {
+        let sock = socket(
+            AddressFamily::Vsock,
+            SockType::Stream,
+            SockFlag::empty(),
+            None,
+        )
+        .unwrap();
+        connect(sock.as_raw_fd(), &VsockAddr::new(VMADDR_CID_HOST, port)).unwrap();
+        UnixStream::from(sock)
+    }
+
+    fn accept_stream(listener: &OwnedFd) -> UnixStream {
+        let fd = accept(listener.as_raw_fd()).unwrap();
+        // Safe because we've just obtained the FD from the `accept` call above.
+        UnixStream::from(unsafe { OwnedFd::from_raw_fd(fd) })
+    }
+
+    impl Test for TestVsockUnixSlowReader {
+        fn in_guest(self: Box<Self>) {
+            let listener = socket(
+                AddressFamily::Vsock,
+                SockType::Stream,
+                SockFlag::empty(),
+                None,
+            )
+            .unwrap();
+            bind(
+                listener.as_raw_fd(),
+                &VsockAddr::new(nix::libc::VMADDR_CID_ANY, ACCEPT_PORT),
+            )
+            .unwrap();
+            listen(&listener, Backlog::new(4).unwrap()).unwrap();
+
+            let mut control = vsock_connect(CONTROL_PORT);
+
+            let mut bulk = accept_stream(&listener);
+            let writer = thread::spawn(move || {
+                let data: Vec<u8> = (0..BULK_LEN).map(byte_at).collect();
+                bulk.write_all(&data).unwrap();
+            });
+
+            let mut ping = accept_stream(&listener);
+            ping.set_read_timeout(Some(IO_TIMEOUT)).unwrap();
+            let mut byte = [0];
+            ping.read_exact(&mut byte).unwrap();
+            ping.write_all(b"pong").unwrap();
+
+            writer.join().unwrap();
+
+            let mut status = [0];
+            control.read_exact(&mut status).unwrap();
+            control.write_all(&[1]).unwrap();
+            assert_eq!(
+                status,
+                [1],
+                "host got no answer on a second connection, or a corrupted stream"
+            );
+            println!("OK");
+        }
+    }
+}
