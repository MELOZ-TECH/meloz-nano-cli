index 15818d18..ee827bc3 100644
--- a/src/devices/src/virtio/vsock/unix_proxy/mod.rs
+++ b/src/devices/src/virtio/vsock/unix_proxy/mod.rs
@@ -39,6 +39,7 @@ pub struct UnixProxy {
     pub(crate) local_port: u32,
     pub(crate) control_port: u32,
     pub(crate) peer_shutdown: u32,
+    pub(crate) host_read_closed: bool,
     pub(crate) peer_fwd_cnt: Wrapping<u32>,
     pub(crate) peer_buf_alloc: u32,
     pub(crate) tx_cnt: Wrapping<u32>,
@@ -73,6 +74,7 @@ impl UnixProxy {
             local_port,
             control_port,
             peer_shutdown: 0,
+            host_read_closed: false,
             peer_fwd_cnt: Wrapping(0),
             peer_buf_alloc: 0,
             tx_cnt: Wrapping(0),
@@ -101,6 +103,7 @@ impl UnixProxy {
             peer_port,
             control_port: 0,
             peer_shutdown: 0,
+            host_read_closed: false,
             fd,
             status: ProxyStatus::ReverseInit,
             mem,
@@ -139,24 +142,39 @@ impl UnixProxy {
         let mut wait_credit = false;
         let mut queue = self.queue.lock().unwrap();
 
-        while let Some(head) = queue.pop(&self.mem) {
+        while !self.host_read_closed {
+            let Some(head) = queue.pop(&self.mem) else {
+                break;
+            };
             let len = match VsockPacket::from_rx_virtq_head(&head) {
                 Ok(mut pkt) => match sys::recv_to_pkt(self, &mut pkt) {
-                    RecvPkt::WaitForCredit => {
+                    Ok(RecvPkt::WaitForCredit) => {
                         wait_credit = true;
                         0
                     }
-                    RecvPkt::Read(cnt) => {
+                    Ok(RecvPkt::Read(cnt)) => {
                         self.rx_cnt += Wrapping(cnt as u32);
                         self.init_data_pkt(&mut pkt);
                         pkt.set_len(cnt as u32);
                         pkt.hdr().len() + cnt
                     }
-                    RecvPkt::Close => {
+                    // The host side stopped writing, but it may still read the
+                    // guest's reply: send a send-only shutdown, ordered after
+                    // the data already pushed, instead of a reset.
+                    Ok(RecvPkt::Close) => {
+                        self.host_read_closed = true;
+                        self.init_data_pkt(&mut pkt);
+                        pkt.set_op(uapi::VSOCK_OP_SHUTDOWN)
+                            .set_flags(uapi::VSOCK_FLAGS_SHUTDOWN_SEND)
+                            .set_len(0);
+                        pkt.hdr().len()
+                    }
+                    Ok(RecvPkt::Error) => 0,
+                    Err(e) => {
+                        debug!("recv_pkt: socket error: {e}");
                         self.status = ProxyStatus::Closed;
                         0
                     }
-                    RecvPkt::Error => 0,
                 },
                 Err(e) => {
                     debug!("recv_pkt: RX queue error: {e:?}");
diff --git a/src/devices/src/virtio/vsock/unix_proxy/unix.rs b/src/devices/src/virtio/vsock/unix_proxy/unix.rs
index 00e62c86..81599fb3 100644
--- a/src/devices/src/virtio/vsock/unix_proxy/unix.rs
+++ b/src/devices/src/virtio/vsock/unix_proxy/unix.rs
@@ -44,23 +44,26 @@ pub(crate) fn create_socket(id: u64) -> Result<PlatformHandle, ProxyError> {
     };
 
     #[cfg(target_os = "macos")]
-    {
-        // nix doesn't provide an abstraction for SO_NOSIGPIPE, fall back to libc.
-        let option_value: libc::c_int = 1;
-        unsafe {
-            libc::setsockopt(
-                fd.as_raw_fd(),
-                libc::SOL_SOCKET,
-                libc::SO_NOSIGPIPE,
-                &option_value as *const _ as *const libc::c_void,
-                std::mem::size_of_val(&option_value) as libc::socklen_t,
-            )
-        };
-    }
+    set_nosigpipe(&fd);
 
     Ok(fd)
 }
 
+#[cfg(target_os = "macos")]
+fn set_nosigpipe(fd: &OwnedFd) {
+    // nix doesn't provide an abstraction for SO_NOSIGPIPE, fall back to libc.
+    let option_value: libc::c_int = 1;
+    unsafe {
+        libc::setsockopt(
+            fd.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_NOSIGPIPE,
+            &option_value as *const _ as *const libc::c_void,
+            std::mem::size_of_val(&option_value) as libc::socklen_t,
+        )
+    };
+}
+
 pub(crate) fn switch_to_connected(proxy: &mut super::UnixProxy) {
     proxy.status = ProxyStatus::Connected;
     match fcntl(&proxy.fd, FcntlArg::F_GETFL) {
@@ -91,7 +94,10 @@ fn push_connect_rsp(proxy: &super::UnixProxy, result: i32) {
     push_packet(proxy.cid, rx, &proxy.rxq, &proxy.queue, &proxy.mem);
 }
 
-pub(crate) fn recv_to_pkt(proxy: &super::UnixProxy, pkt: &mut VsockPacket) -> RecvPkt {
+pub(crate) fn recv_to_pkt(
+    proxy: &super::UnixProxy,
+    pkt: &mut VsockPacket,
+) -> std::io::Result<RecvPkt> {
     if let Some(buf) = pkt.buf_mut() {
         let peer_credit = proxy.peer_avail_credit();
         let max_len = std::cmp::min(buf.len(), peer_credit);
@@ -104,7 +110,7 @@ pub(crate) fn recv_to_pkt(proxy: &super::UnixProxy, pkt: &mut VsockPacket) -> Re
         );
 
         if max_len == 0 {
-            return RecvPkt::WaitForCredit;
+            return Ok(RecvPkt::WaitForCredit);
         }
 
         match recv(
@@ -116,22 +122,17 @@ pub(crate) fn recv_to_pkt(proxy: &super::UnixProxy, pkt: &mut VsockPacket) -> Re
                 debug!("recv cnt={cnt}");
                 if cnt > 0 {
                     debug!("recv rx_cnt={}", proxy.rx_cnt);
-                    RecvPkt::Read(cnt)
+                    Ok(RecvPkt::Read(cnt))
                 } else {
-                    RecvPkt::Close
-                }
-            }
-            Err(e) => {
-                debug!("recv_pkt: recv error: {e:?}");
-                match e {
-                    Errno::EAGAIN | Errno::EINTR => RecvPkt::Error,
-                    _ => RecvPkt::Close,
+                    Ok(RecvPkt::Close)
                 }
             }
+            Err(Errno::EAGAIN | Errno::EINTR) => Ok(RecvPkt::Error),
+            Err(e) => Err(e.into()),
         }
     } else {
         debug!("recv_pkt: pkt without buf");
-        RecvPkt::Error
+        Ok(RecvPkt::Error)
     }
 }
 
@@ -267,7 +268,10 @@ pub(crate) fn update_peer_credit(proxy: &mut super::UnixProxy, pkt: &VsockPacket
     proxy.peer_buf_alloc = pkt.buf_alloc();
     proxy.peer_fwd_cnt = Wrapping(pkt.fwd_cnt());
 
-    if proxy.status != ProxyStatus::WaitingCreditUpdate || proxy.peer_avail_credit() == 0 {
+    if proxy.host_read_closed
+        || proxy.status != ProxyStatus::WaitingCreditUpdate
+        || proxy.peer_avail_credit() == 0
+    {
         return ProxyUpdate::default();
     }
 
@@ -404,8 +408,8 @@ pub(crate) fn process_event(proxy: &mut super::UnixProxy, evset: EventSet) -> Pr
                 update.polling = Some((proxy.id, proxy.fd.as_raw_fd(), EventSet::empty()));
                 update.remove_proxy = ProxyRemoval::Deferred;
                 return update;
-            } else if proxy.status == ProxyStatus::WaitingCreditUpdate {
-                debug!("process_event: WaitingCreditUpdate");
+            } else if proxy.host_read_closed || proxy.status == ProxyStatus::WaitingCreditUpdate {
+                debug!("process_event: disabling read polling");
                 update.polling = Some((proxy.id, proxy.fd.as_raw_fd(), EventSet::empty()));
             }
         } else {
@@ -477,6 +481,10 @@ pub(crate) fn process_acceptor_event(
             Ok(accept_fd) => {
                 // Safe because we've just obtained the FD from the `accept` call above.
                 let new_fd = unsafe { OwnedFd::from_raw_fd(accept_fd) };
+                // The guest can keep writing after the host side stops, and the
+                // host side may be gone by then: report EPIPE, don't raise SIGPIPE.
+                #[cfg(target_os = "macos")]
+                set_nosigpipe(&new_fd);
                 update.new_proxy = Some((
                     proxy.peer_port,
                     new_fd,
diff --git a/src/devices/src/virtio/vsock/unix_proxy/windows.rs b/src/devices/src/virtio/vsock/unix_proxy/windows.rs
